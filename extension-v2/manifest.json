{
  "manifest_version": 3,
  "name": "SmartBookshelf AI Assistant",
  "short_name": "SmartBookshelf AI",
  "version": "2.0.0",
  "description": "SmartBookshelf AI ကို လက်ရှိ tab ပေါ်တွင် လုံခြုံစွာ အသုံးပြုနိုင်သော assistant",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://my-ai-proxy.jokertalor.workers.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
